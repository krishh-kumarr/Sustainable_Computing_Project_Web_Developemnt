# ---------------------------------------------------------------------------
# TerraVerse AI — environment configuration
#
# Copy this file to `.env` and fill in the values you have.
#   cp .env.example .env
#
# These variables are read ONLY by the backend proxy (server/index.mjs).
# They are deliberately NOT prefixed with VITE_, because any VITE_ variable is
# inlined into the frontend bundle and therefore publicly readable.
# Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Optional operational settings
# ---------------------------------------------------------------------------

# Port the backend proxy listens on (default 8787). If you change this, also
# update the `/api` proxy target in vite.config.ts.
PROXY_PORT=8787

# Overpass API endpoint used for OpenStreetMap feature queries.
# Override to use a mirror if the main instance is rate-limiting you.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Contact string sent as the User-Agent for Overpass / OSM requests.
# The OSM usage policy asks for an identifiable agent.
OSM_USER_AGENT=TerraVerseAI/1.0 (sustainable-computing coursework project)

# ---------------------------------------------------------------------------
# Frontend configuration (public — inlined into the client bundle)
# ---------------------------------------------------------------------------

# HTTP endpoint of a waste-image classification service. It must accept
# multipart/form-data with an `image` field and return the ClassificationResponse
# shape documented in src/services/domain/wasteClassification.ts.
# Leave unset: the Smart Waste module then reports that model integration is
# pending instead of showing a placeholder prediction.
# This is safe as a VITE_ variable because it is a public URL, not a credential.
# If your model needs a credential, route it through the backend proxy instead.
VITE_WASTE_MODEL_ENDPOINT=
